<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark parchment. A dark parent theme is also what makes the WebView report
         prefers-color-scheme: dark (targetSdk 33+ follows the app theme). -->
    <color name="allen_cream">#1D1712</color>
    <color name="allen_terracotta">#E08A55</color>
    <style name="AllenTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/allen_cream</item>
        <item name="android:colorPrimary">@color/allen_terracotta</item>
        <item name="android:colorAccent">@color/allen_terracotta</item>
        <item name="android:statusBarColor">@color/allen_cream</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
