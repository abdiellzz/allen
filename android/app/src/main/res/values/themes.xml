<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parchment canvas; also painted behind the system bars by MainActivity. -->
    <color name="allen_cream">#FEF9EF</color>
    <!-- Launcher icon background (mipmap-anydpi-v26/ic_launcher.xml). -->
    <color name="allen_orange">#F07C1A</color>
    <color name="allen_terracotta">#C8662A</color>
    <style name="AllenTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/allen_cream</item>
        <item name="android:colorPrimary">@color/allen_terracotta</item>
        <item name="android:colorAccent">@color/allen_terracotta</item>
        <item name="android:statusBarColor">@color/allen_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
